{
  "name": "@fevolq/voxchat",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile voice interaction plugin for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fevolq/VoxChat.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build && npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  }
}
